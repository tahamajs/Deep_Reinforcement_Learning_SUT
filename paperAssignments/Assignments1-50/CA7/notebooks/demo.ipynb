   "source": [
    "## 3. Plotting ideas\n",
    "\n",
    "Below are example matplotlib calls to plot returns and trace norms from logs (assumes a `logs.csv` exists).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "def plot_returns(log_csv=\"../logs.csv\"):\n",
    "    df = pd.read_csv(log_csv)\n",
    "    plt.figure(figsize=(6, 4))\n",
    "    plt.plot(df[\"step\"], df[\"return_mean\"], label=\"return\")\n",
    "    plt.fill_between(\n",
    "        df[\"step\"],\n",
    "        df[\"return_mean\"] - df[\"return_std\"],\n",
    "        df[\"return_mean\"] + df[\"return_std\"],\n",
    "        alpha=0.2,\n",
    "    )\n",
    "    plt.xlabel(\"steps\")\n",
    "    plt.ylabel(\"return\")\n",
    "    plt.legend()\n",
    "    plt.savefig(\"../pictures/fig_returns.png\", dpi=300)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_metrics(log_csv=\"../logs.csv\"):\n",
    "    try:\n",
    "        df = pd.read_csv(log_csv)\n",
    "    except Exception:\n",
    "        # synthesize example data\n",
    "        import numpy as _np\n",
    "\n",
    "        steps = _np.arange(0, 1000, 10)\n",
    "        df = pd.DataFrame(\n",
    "            {\n",
    "                \"step\": steps,\n",
    "                \"return_mean\": _np.sin(steps / 200.0) * 5 + 10,\n",
    "                \"return_std\": _np.clip(_np.random.rand(len(steps)) * 1.0, 0.1, 1.5),\n",
    "                \"trace_norm_mean\": _np.clip(\n",
    "                    _np.linspace(0.5, 3.0, len(steps))\n",
    "                    + _np.random.randn(len(steps)) * 0.1,\n",
    "                    0.1,\n",
    "                    5.0,\n",
    "                ),\n",
    "                \"rho_mean\": _np.clip(\n",
    "                    1.0 + _np.random.randn(len(steps)) * 0.1, 0.1, 5.0\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    fig, axes = plt.subplots(3, 1, figsize=(8, 10), sharex=True)\n",
    "    axes[0].plot(df[\"step\"], df[\"return_mean\"], label=\"return_mean\")\n",
    "    axes[0].fill_between(\n",
    "        df[\"step\"],\n",
    "        df[\"return_mean\"] - df[\"return_std\"],\n",
    "        df[\"return_mean\"] + df[\"return_std\"],\n",
    "        alpha=0.2,\n",
    "    )\n",
    "    axes[0].set_ylabel(\"Return\")\n",
    "    axes[0].legend()\n",
    "\n",
    "    axes[1].plot(df[\"step\"], df[\"trace_norm_mean\"], label=\"trace_norm_mean\", color=\"C1\")\n",
    "    axes[1].set_ylabel(\"Trace norm\")\n",
    "    axes[1].legend()\n",
    "\n",
    "    axes[2].plot(df[\"step\"], df[\"rho_mean\"], label=\"rho_mean\", color=\"C2\")\n",
    "    axes[2].axhline(2.0, color=\"k\", linestyle=\"--\", label=\"rho_clip\")\n",
    "    axes[2].set_ylabel(\"IS ratio\")\n",
    "    axes[2].set_xlabel(\"steps\")\n",
    "    axes[2].legend()\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"../pictures/fig_metrics.png\", dpi=300)\n",
    "    print(\"Saved ../pictures/fig_metrics.png\")"
   ]
  }
  ,
